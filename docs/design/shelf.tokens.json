{
  "name": "Shelf",
  "version": 1,
  "font": {
    "family": "Plus Jakarta Sans",
    "fallback": ["system-ui", "sans-serif"],
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 }
  },
  "themeModel": {
    "inputs": ["background", "surface", "foreground", "accent", "border", "glow"],
    "derived": {
      "surface2": "mix(surface, foreground, 3%)",
      "surface3": "mix(surface, foreground, 6%)",
      "borderSubtle": "surface3",
      "borderStrong": "border",
      "text": "foreground",
      "text2": "mix(foreground, background, 11%)",
      "muted": "mix(foreground, background, 35%)",
      "faint": "mix(foreground, background, 60%)",
      "accentSoft": "accent at 14% opacity",
      "onAccent": "black or white, whichever has the higher WCAG contrast against accent"
    },
    "semantic": {
      "success": "#34d399",
      "danger": "#ff6b81",
      "info": "#60a5fa"
    }
  },
  "themes": {
    "shelfDark": {
      "name": "Shelf Dark (new default)",
      "background": "#0e0f12",
      "surface": "#15161b",
      "foreground": "#f2f2f3",
      "accent": "#f5a524",
      "border": "#3a3c45",
      "glow": "#f5a524"
    },
    "dark": { "background": "#000000", "surface": "#0f0f12", "foreground": "#ffffff", "accent": "#2563eb", "border": "#ffffff", "glow": "#3b82f6" },
    "light": { "background": "#f5f4ef", "surface": "#ffffff", "foreground": "#15151b", "accent": "#4f46e5", "border": "#15151b", "glow": "#818cf8" },
    "colorful": { "background": "#0b0720", "surface": "#1a1240", "foreground": "#fdf2ff", "accent": "#ff3ea5", "border": "#7c4dff", "glow": "#22d3ee" },
    "freaky": { "background": "#04040e", "surface": "#0e0e26", "foreground": "#eaffe9", "accent": "#a3ff12", "border": "#00ffd0", "glow": "#ff00e5" }
  },
  "type": {
    "display": { "size": 64, "lineHeight": 1.0, "weight": 800, "letterSpacing": "-0.03em" },
    "page": { "size": 40, "lineHeight": 1.05, "weight": 800, "letterSpacing": "-0.03em" },
    "section": { "size": 22, "lineHeight": 1.2, "weight": 800, "letterSpacing": "-0.01em" },
    "panelTitle": { "size": 18, "lineHeight": 1.2, "weight": 800, "letterSpacing": "-0.01em" },
    "lead": { "size": 17, "lineHeight": 1.6, "weight": 400 },
    "body": { "size": 15, "lineHeight": 1.45, "weight": 400 },
    "label": { "size": 13, "lineHeight": 1.3, "weight": 600 },
    "caption": { "size": 13, "lineHeight": 1.3, "weight": 400 },
    "eyebrow": { "size": 13, "lineHeight": 1.2, "weight": 700, "letterSpacing": "0.14em", "uppercase": true },
    "coverTitle": { "size": 18, "lineHeight": 1.1, "weight": 800 }
  },
  "space": [4, 8, 12, 16, 20, 24, 28, 32, 48, 56],
  "radius": { "field": 12, "card": 16, "panel": 22, "dialog": 24, "hero": 28, "pill": 999 },
  "elevation": {
    "menu": "0 16px 48px rgba(0,0,0,0.55)",
    "dialog": "0 24px 80px rgba(0,0,0,0.6)",
    "cover": "0 24px 60px rgba(0,0,0,0.55)"
  },
  "motion": {
    "fast": { "ms": 150, "curve": "easeOut" },
    "base": { "ms": 250, "curve": "easeOut" },
    "page": { "ms": 350, "curve": "easeOut", "note": "pages slide in 12px" },
    "reducedMotion": "respect the platform setting: no slide, no scale"
  },
  "layout": {
    "pagePaddingX": 56,
    "contentMaxWidth": 1600,
    "narrowPageMaxWidth": 880,
    "sidebarWidth": 292,
    "coverMinWidth": 168,
    "coverAspect": "2:3",
    "coverGap": { "row": 28, "column": 20 },
    "topbarHeight": 86,
    "touchTargetMin": 44
  },
  "focus": { "outline": "3px solid accent", "offset": 3 },
  "selection": { "outline": "3px solid accent", "offset": 3, "checkSize": 26 }
}
