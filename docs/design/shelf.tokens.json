{
  "name": "Shelf",
  "version": 2,
  "platform": "desktop",
  "font": {
    "family": "Plus Jakarta Sans",
    "fallback": ["system-ui", "sans-serif"],
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 }
  },
  "themeModel": {
    "inputs": ["background", "surface", "foreground", "accent", "border", "glow"],
    "derived": {
      "surface2": "mix(surface, foreground, 3%)",
      "surface3": "mix(surface, foreground, 6%)",
      "borderSubtle": "surface3",
      "borderStrong": "border",
      "text": "foreground",
      "text2": "mix(foreground, background, 11%)",
      "muted": "mix(foreground, background, 35%)",
      "faint": "mix(foreground, background, 60%)",
      "accentSoft": "accent at 14% opacity",
      "onAccent": "black or white, whichever has the higher WCAG contrast against accent"
    },
    "semantic": {
      "success": "#34d399",
      "danger": "#ff6b81",
      "info": "#60a5fa"
    }
  },
  "themes": {
    "shelfDark": {
      "name": "Shelf Dark (new default)",
      "background": "#0e0f12",
      "surface": "#15161b",
      "foreground": "#f2f2f3",
      "accent": "#f5a524",
      "border": "#3a3c45",
      "glow": "#f5a524"
    },
    "dark": { "background": "#000000", "surface": "#0f0f12", "foreground": "#ffffff", "accent": "#2563eb", "border": "#ffffff", "glow": "#3b82f6" },
    "light": { "background": "#f5f4ef", "surface": "#ffffff", "foreground": "#15151b", "accent": "#4f46e5", "border": "#15151b", "glow": "#818cf8" },
    "colorful": { "background": "#0b0720", "surface": "#1a1240", "foreground": "#fdf2ff", "accent": "#ff3ea5", "border": "#7c4dff", "glow": "#22d3ee" },
    "freaky": { "background": "#04040e", "surface": "#0e0e26", "foreground": "#eaffe9", "accent": "#a3ff12", "border": "#00ffd0", "glow": "#ff00e5" }
  },
  "type": {
    "hero": { "size": 30, "lineHeight": 1.1, "weight": 800, "letterSpacing": "-0.02em" },
    "page": { "size": 26, "lineHeight": 1.1, "weight": 800, "letterSpacing": "-0.02em" },
    "section": { "size": 16, "lineHeight": 1.25, "weight": 800, "letterSpacing": "-0.01em" },
    "groupTitle": { "size": 13, "lineHeight": 1.3, "weight": 800 },
    "body": { "size": 14, "lineHeight": 1.4, "weight": 400 },
    "control": { "size": 13, "lineHeight": 1.2, "weight": 600 },
    "label": { "size": 12, "lineHeight": 1.3, "weight": 600 },
    "caption": { "size": 12.5, "lineHeight": 1.3, "weight": 400 },
    "eyebrow": { "size": 11, "lineHeight": 1.2, "weight": 700, "letterSpacing": "0.12em", "uppercase": true },
    "sidebarLabel": { "size": 11, "lineHeight": 1.2, "weight": 700, "letterSpacing": "0.08em", "uppercase": true },
    "coverTitle": { "size": 15, "lineHeight": 1.1, "weight": 800 }
  },
  "space": [4, 6, 8, 10, 12, 14, 16, 20, 24, 32],
  "radius": { "control": 8, "card": 12, "panel": 14, "dialog": 16, "window": 12, "chip": 999 },
  "elevation": {
    "menu": "0 16px 48px rgba(0,0,0,0.55)",
    "sheet": "0 24px 80px rgba(0,0,0,0.6)",
    "window": "0 30px 90px rgba(0,0,0,0.7)",
    "segmentedThumb": "0 1px 2px rgba(0,0,0,0.4)"
  },
  "motion": {
    "fast": { "ms": 150, "curve": "easeOut", "use": "hover, press, menu open" },
    "base": { "ms": 250, "curve": "easeOut", "use": "inspector slide, sheet drop (8px)" },
    "reducedMotion": "respect the platform setting: no slide, no scale"
  },
  "layout": {
    "referenceWindow": { "width": 1440, "height": 900 },
    "titlebar": 52,
    "toolbar": 48,
    "statusbar": 28,
    "sidebar": 232,
    "inspector": 380,
    "contentPaddingX": 24,
    "contentPaddingY": 22,
    "controlHeight": 32,
    "inputHeight": 34,
    "rowHeight": 36,
    "tableRowHeight": 48,
    "tableHeaderHeight": 34,
    "coverMinWidth": 150,
    "coverAspect": "2:3",
    "coverGap": { "row": 22, "column": 16 },
    "settingsWindow": { "width": 1000, "height": 740, "sidebar": 200 },
    "setupWindow": { "width": 880, "height": 640, "stepper": 240 },
    "signInWindow": { "width": 440, "height": 560 },
    "sheetWidths": { "compact": 520, "default": 640, "wide": 680 },
    "touchTargetMin": 32
  },
  "focus": { "outline": "2px solid accent", "offset": 2 },
  "selection": { "outline": "3px solid accent", "offset": 3, "checkSize": 22 },
  "windowChrome": {
    "macos": "traffic lights top left, 12px, 8px apart, inside the 52px title bar",
    "windows": "native caption buttons top right; the title bar content shifts left",
    "linux": "client-side decorations with the same caption buttons as Windows"
  }
}
