# SQLAlchemy async connection string (note the +asyncpg driver suffix,
# unlike the frontend's plain postgresql:// URL)
POSTGRES_URL=postgresql+asyncpg://postgres:1234@localhost:5432/backlog-manager-db

# Secret used to sign JWT access tokens. Generate one with
# `openssl rand -base64 32` - do not commit a real value, and never
# reuse this placeholder as an actual secret.
AUTH_SECRET=replace-with-your-own-generated-secret

# Fernet key used to encrypt TOTP 2FA secrets at rest. Must be a 32
# url-safe base64 byte key (not an arbitrary string like AUTH_SECRET) -
# generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=replace-with-your-own-generated-fernet-key

# IGDB API (Twitch Developer application credentials), optional - IGDB
# search/enrichment endpoints are disabled without these
# https://api-docs.igdb.com/#getting-started
IGDB_CLIENT_ID=your-igdb-client-id
IGDB_CLIENT_SECRET=your-igdb-client-secret

# There is no public self-registration endpoint - every account after
# the first is created by an admin via POST /api/admin/users. Set both
# of these to real values (only needed once, for the very first
# deployment) to create that first admin account automatically on
# startup. Left empty here deliberately: if this file is ever copied
# to .env without editing it, bootstrap must not fire with a
# guessable, publicly-known login. Safe to leave unset on every later
# run too, since by then a user already exists and this is a no-op.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Comma-separated list of origins the browser is allowed to call this API
# from (the frontend talks to it directly, cross-origin - no Next.js proxy
# in front). Add the production frontend URL alongside localhost once
# deployed, e.g. "http://localhost:3000,https://your-domain.example"
CORS_ALLOWED_ORIGINS=http://localhost:3000
