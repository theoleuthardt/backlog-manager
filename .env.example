# When adding additional environment variables, update
# backend/src/backlog_manager_backend/config.py accordingly.
BACKEND_PORT=8000

# Secret used by the backend to sign JWT access tokens. Generate one with:
# openssl rand -base64 32
AUTH_SECRET="generate-your-own-with-openssl-rand--base64-32"

# Fernet key used by the backend to encrypt TOTP 2FA secrets at rest.
# Must be a 32 url-safe base64 byte key (not an arbitrary string) -
# generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY="generate-your-own-fernet-key"

# IGDB API (Twitch Developer application credentials)
# https://api-docs.igdb.com/#getting-started
IGDB_CLIENT_ID=your-igdb-client-id
IGDB_CLIENT_SECRET=your-igdb-client-secret

# Steam Web API key, used to sync backlog entry playtimes from a user's
# linked Steam library. Server-wide fallback for users who haven't set
# their own key in Account settings - get one at
# https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=your-steam-web-api-key

# Fernet key used to encrypt a user's own Steam Web API key at rest.
# Required for users to be able to set their own key; generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STEAM_API_KEY_ENCRYPTION_KEY="generate-your-own-fernet-key"

# SteamGridDB API key, used to fetch game cover art (preferred over IGDB
# covers where available) - get one at
# https://www.steamgriddb.com/profile/preferences/api
STEAMGRIDDB_API_KEY=your-steamgriddb-api-key

# Shared secret a scheduler (the Steam wishlist sync cron container) sends as
# the X-Cron-Secret header to call POST /api/steam/wishlist/auto-sync, which
# is not gated by a user's JWT (the name is from the time of the price sweep).
# Generate one with: openssl rand -base64 32
PRICE_CHECK_CRON_SECRET=

# There is no public self-registration endpoint - every account after the
# first is created by an admin via POST /api/admin/users. Set both of these
# to real values (only needed once, for the very first deployment) to have
# the backend create that first admin account automatically on startup.
# Leave empty on every later run - by then a user already exists and this
# is a no-op.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Comma-separated list of browser origins allowed to call the backend. The
# Flutter app is not a browser and needs none; only add an origin for a
# browser-based tool that calls the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Comma-separated IPs/CIDRs of the reverse proxy in front of the backend
# (e.g. its container network, "172.18.0.0/16"). Only
# requests from these addresses may supply the real client IP via
# CF-Connecting-IP, which the login rate limit keys on. Leave empty when
# the backend is reached directly.
TRUSTED_PROXY_IPS=

# Set to true to serve the OpenAPI schema and Swagger UI under /schema.
# Keep false on the public deployment.
ENABLE_DOCS=false

# Daily automatic per-user backups inside the API process (see
# docs/BACKUPS.md). The production stack's variables live in
# .env.prod.example.
BACKUP_SCHEDULER_ENABLED=true

# Postgresql (uncomment just one POSTGRES_URL) - note the +asyncpg driver
# suffix, required by the backend's SQLAlchemy async engine.
# Local Docker:
POSTGRES_URL=postgresql+asyncpg://postgres:1234@localhost:5432/backlog-manager-db
# Supabase Transaction Pooler:
#  POSTGRES_URL=postgresql+asyncpg://postgres.xxx:[PASSWORD]@aws-1-region.pooler.supabase.com:6543/postgres

# Docker Compose variables (only needed when using local Docker setup)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_DB=backlog-manager-db
POSTGRES_PORT=5432

# PGAdmin
PGADMIN_DEFAULT_EMAIL=theoleuthardt12@gmail.com
PGADMIN_DEFAULT_PASSWORD=1234
PGADMIN_PORT=8080

# Monitor (monitor/, Spring Boot): its own role and database in the local
# Postgres above, created with `task monitor:db:create` after `task db:up`.
# `task monitor:dev` passes these to the Monitor (profile dev), which listens
# on 127.0.0.1:MONITOR_PORT (not on 8080, which pgAdmin uses; set
# MONITOR_ADDRESS=0.0.0.0 to reach it from the network).
MONITOR_DB_NAME=monitor
MONITOR_DB_USER=monitor
MONITOR_DB_PASSWORD=change-me-monitor
MONITOR_PORT=8090
