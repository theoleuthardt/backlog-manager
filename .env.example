# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.
# NextJS
NODE_ENV=development
HOSTNAME=localhost
NEXTJS_PORT=3000

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
# https://next-auth.js.org/configuration/options#secret
AUTH_SECRET="generate-your-own-with-npx-auth-secret"

# IGDB API (Twitch Developer application credentials)
# https://api-docs.igdb.com/#getting-started
IGDB_CLIENT_ID=your-igdb-client-id
IGDB_CLIENT_SECRET=your-igdb-client-secret

# Postresql (uncomment just one POSTGRES_URL)
# Local Docker:
POSTGRES_URL=postgresql://postgres:1234@localhost:5432/backlog-manager-db
# Supabase Transaction Pooler:
#  POSTGRES_URL=postgresql://postgres.xxx:[PASSWORD]@aws-1-region.pooler.supabase.com:6543/postgres

# Docker Compose variables (only needed when using local Docker setup)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_DB=backlog-manager-db
POSTGRES_PORT=5432

# PGAdmin
PGADMIN_DEFAULT_EMAIL=theoleuthardt12@gmail.com
PGADMIN_DEFAULT_PASSWORD=1234
PGADMIN_PORT=8080