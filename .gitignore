.env
.env*.local
.env.prod

# typescript
*.tsbuildinfo

# editor
.idea
.vscode

# local docker files
/compose/.env
.vscode/settings.json

# tauri (desktop app) build artifacts, tracked in the source folder itself
# but not fully covered by src-tauri/.gitignore on branches that predate it
/src-tauri/target/
/src-tauri/gen/schemas
/src-tauri/resources/

# claude
.claude

# python backend
backend/.pytest_cache/
backend/.ruff_cache/