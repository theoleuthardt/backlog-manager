/prisma/db.sqlite
/prisma/db.sqlite-journal
db.sqlite

# next.js
.next/
out/
next-env.d.ts

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
