{
  "name": "backlog-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=4096' next build --webpack",
    "build:tauri": "cross-env TAURI_BUILD=1 NODE_OPTIONS=--max-old-space-size=4096 next build --webpack",
    "check": "eslint . && tsc --noEmit",
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' next dev --turbo",
    "dev:webpack": "NODE_OPTIONS='--max-old-space-size=4096' next dev --webpack",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "generate-api-types": "openapi-typescript ../backend/openapi.json -o ./src/lib/api/schema.d.ts --default-non-nullable=false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "NODE_OPTIONS='--max-old-space-size=4096' next build --webpack && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "animated-backgrounds": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.543.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "use-callback-ref": "^1.3.3",
    "uuid": "^10.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^20.14.10",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/uuid": "^10.0.0",
    "baseline-browser-mapping": "^2.8.32",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.23.0",
    "eslint-config-next": "16.3.4",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.15",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.39.3"
  },
  "packageManager": "npm@11.3.0",
  "overrides": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3"
  }
}
