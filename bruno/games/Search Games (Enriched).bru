meta {
  name: Search Games (Enriched)
  type: http
  seq: 1
}

get {
  url: {{backendUrl}}/api/games/enriched-search?search_term=Zelda
  body: none
  auth: bearer
}

params:query {
  search_term: Zelda
}

auth:bearer {
  token: {{authToken}}
}

docs {
  Frontend-facing search used by SearchBar/MissingGamesModal. Run
  auth/Login first.

  Searches IGDB, then enriches the top 8 matches with cover image, genres,
  platforms, and beat times (IGDB game_time_to_beats, falling back to
  HowLongToBeat when IGDB has no data for that game). This is the slowest
  endpoint since it makes several sequential IGDB requests per game.

  503 if neither the caller nor the server has IGDB credentials
  configured, or if IGDB is unreachable.
}
