meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{backendUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "test@test.com",
    "password": "test1234"
  }
}

script:post-response {
  if (res.body.access_token) {
    bru.setEnvVar("authToken", res.body.access_token);
  }
}

docs {
  Logs in and stores the access token in the authToken environment
  variable, used by every other request in this folder. Run this first.
}
