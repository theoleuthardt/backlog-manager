meta {
  name: Set Steam API Key
  type: http
  seq: 4
}

put {
  url: {{backendUrl}}/api/user/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "steam_api_key": "your-steam-web-api-key"
  }
}

docs {
  Stores the caller's own Steam Web API key, encrypted at rest, taking
  priority over the server-wide STEAM_WEB_API_KEY fallback for this
  user's syncs. Get a key at https://steamcommunity.com/dev/apikey. Run
  auth/Login first.

  Returns 503 if the backend doesn't have STEAM_API_KEY_ENCRYPTION_KEY
  configured.
}
