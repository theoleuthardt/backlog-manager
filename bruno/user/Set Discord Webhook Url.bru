meta {
  name: Set Discord Webhook Url
  type: http
  seq: 12
}

put {
  url: {{backendUrl}}/api/user/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "discord_webhook_url": "https://discord.com/api/webhooks/your-webhook-id/your-webhook-token"
  }
}

docs {
  Stores the caller's own Discord webhook URL, encrypted at rest, taking
  priority over the server-wide DISCORD_WEBHOOK_URL fallback when the
  price-check sweep (see prices/Check Prices) posts a sale alert. Create
  one via a Discord channel's Integrations > Webhooks settings. Sending
  an empty string clears it, same pattern as user/Remove Steam API Key.
  Run auth/Login first.

  Returns 503 if the backend doesn't have STEAM_API_KEY_ENCRYPTION_KEY
  configured (the same Fernet key backs every per-user credential
  column, not just Steam's).
}
