meta {
  name: Remove Steam API Key
  type: http
  seq: 5
}

put {
  url: {{backendUrl}}/api/user/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "steam_api_key": ""
  }
}

docs {
  Clears the caller's own Steam API key (an empty string clears it, same
  as a request that omits the field leaves it unchanged). Syncs fall
  back to the server-wide key afterwards, if one is configured. Run
  auth/Login first.
}
