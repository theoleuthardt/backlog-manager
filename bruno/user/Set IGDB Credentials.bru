meta {
  name: Set IGDB Credentials
  type: http
  seq: 7
}

put {
  url: {{backendUrl}}/api/user/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "igdb_client_id": "your-twitch-client-id",
    "igdb_client_secret": "your-twitch-client-secret"
  }
}

docs {
  Stores the caller's own IGDB (Twitch OAuth2 client-credentials)
  client_id/client_secret pair, encrypted together as one blob, taking
  priority over the server-wide IGDB_CLIENT_ID/IGDB_CLIENT_SECRET
  fallback for this user's games/* requests.

  igdb_client_id and igdb_client_secret must be set or cleared
  together: sending only one of them (with the other omitted or blank)
  returns 400. Sending both as empty strings clears the pair. Run
  auth/Login first.

  Returns 503 if the backend doesn't have STEAM_API_KEY_ENCRYPTION_KEY
  configured.
}
