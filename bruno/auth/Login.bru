meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{backendUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "test@test.com",
    "password": "test1234"
  }
}

script:post-response {
  if (res.body.access_token) {
    bru.setEnvVar("authToken", res.body.access_token);
  }
}

docs {
  Logs in and stores the access token in the authToken environment
  variable, shared by every folder in this collection. Run this first.

  Rate-limited to 10 requests/minute. If the account has 2FA enabled,
  access_token is omitted and requires_2fa/challenge_token are set
  instead - exchange the challenge_token at "2FA Login Verify" for a
  real access_token. 401 for bad credentials.
}
