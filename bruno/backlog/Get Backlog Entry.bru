meta {
  name: Get Backlog Entry
  type: http
  seq: 3
}

get {
  url: {{backendUrl}}/api/backlog/entries/{{entryId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

docs {
  Fetches one backlog entry by id. Run auth/Login and "Create Backlog
  Entry" first so entryId is set.

  404 if the entry doesn't exist or isn't owned by the caller (the two
  are indistinguishable on purpose - existence of another user's entry
  is never revealed).
}
