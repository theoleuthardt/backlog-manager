meta {
  name: Get Backlog Entry Duplicates
  type: http
  seq: 3
}

get {
  url: {{backendUrl}}/api/backlog/entries/duplicates
  body: none
  auth: bearer
}

params:query {
  title: Elden Ring
  ~steam_app_id: 1245620
  ~space_id: {{spaceId}}
}

auth:bearer {
  token: {{authToken}}
}

docs {
  Pre-create duplicate check for the creation tool: returns the
  logged-in user's entries whose title matches the given title
  (case-insensitive) or whose steam_app_id matches, so the UI can ask
  whether to add the game anyway. Returns 400 if title is missing or
  blank. Enable space_id to check the shared space instead of the
  personal backlog. Run auth/Login first.
}