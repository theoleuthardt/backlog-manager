meta {
  name: Remove Category From Entry
  type: http
  seq: 11
}

delete {
  url: {{backendUrl}}/api/backlog/entries/{{entryId}}/categories/{{categoryId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

docs {
  Detaches a category from a backlog entry. Run auth/Login and "Add
  Category To Entry" first.

  404 if either the entry or the category doesn't exist or isn't owned
  by the caller. Not an error if the two weren't associated to begin
  with.
}
