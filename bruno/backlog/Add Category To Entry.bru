meta {
  name: Add Category To Entry
  type: http
  seq: 8
}

post {
  url: {{backendUrl}}/api/backlog/entries/{{entryId}}/categories/{{categoryId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

docs {
  Attaches a category to a backlog entry (many-to-many; both must be
  owned by the caller). Run auth/Login, "Create Backlog Entry", and
  "Create Category" first so entryId/categoryId are set.

  404 if either the entry or the category doesn't exist or isn't owned
  by the caller.
}
