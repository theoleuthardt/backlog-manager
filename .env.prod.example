# Production environment for compose.prod.yml.
# On the server copy this file to `.env` next to compose.prod.yml, fill in every
# <...> value and `chmod 600 .env`. Never commit the real file.
#
# Unlike .env.example (local development) there is no POSTGRES_URL here: the
# compose file builds it from the POSTGRES_* values below.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=blm
# Letters and digits only - the password is embedded in the connection URL.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=<openssl rand -hex 24>
# Must stay exactly this: postgres/backlogmanagerdb-init.sql contains
# ALTER DATABASE "backlog-manager-db".
POSTGRES_DB=backlog-manager-db

# --- Backend secrets --------------------------------------------------------
# The backend refuses to start with a short or placeholder AUTH_SECRET and with
# invalid Fernet keys.
# Generate with: openssl rand -hex 32
AUTH_SECRET=<openssl rand -hex 32>
# Fernet keys, generate each with the backend image (no Python needed locally):
#   docker run --rm ghcr.io/theoleuthardt/backlog-manager-backend:latest \
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Use two different keys.
TOTP_ENCRYPTION_KEY=<fernet key>
STEAM_API_KEY_ENCRYPTION_KEY=<a second fernet key>
# Shared secret of the price-check cron container. Generate with: openssl rand -hex 32
PRICE_CHECK_CRON_SECRET=<openssl rand -hex 32>

# --- First admin ------------------------------------------------------------
# Created on the first start when no admin exists yet (12-128 characters).
# Empty both values after the first successful start.
INITIAL_ADMIN_EMAIL=<you@example.com>
INITIAL_ADMIN_PASSWORD=<a long password>

# --- Network and security ---------------------------------------------------
# Origins of the Tauri desktop app (macOS/Linux and Windows). If the app reports
# a CORS error, add the origin shown in the error message.
CORS_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost
# IP or CIDR of whatever connects to the backend, i.e. cloudflared, so the login
# rate limit sees the real client IP from CF-Connecting-IP. Leave empty until
# you looked up the address the backend sees (its access log shows the peer).
TRUSTED_PROXY_IPS=
# Serve the OpenAPI schema and Swagger UI under /schema. Keep false in prod.
ENABLE_DOCS=false
# Daily automatic per-user backups inside the API process (single worker only).
BACKUP_SCHEDULER_ENABLED=true

# --- Compose ----------------------------------------------------------------
# Pin the commit you deploy for the first install, later switch to :latest:
#   ghcr.io/theoleuthardt/backlog-manager-backend:<commit sha>
BACKEND_IMAGE=ghcr.io/theoleuthardt/backlog-manager-backend:latest
# LAN IP of the server when cloudflared runs on another machine, 127.0.0.1 when
# it runs on this one. 0.0.0.0 publishes the port on every interface.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000

# --- Optional integrations --------------------------------------------------
# Server-wide fallbacks; every user can also set their own keys in Account
# settings. Remove the lines you do not use.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
STEAM_WEB_API_KEY=
STEAMGRIDDB_API_KEY=
DISCORD_WEBHOOK_URL=
