{
  "name": "backlog-manager",
  "private": true,
  "description": "Convenience scripts delegating to frontend/. The Node.js app itself lives entirely in frontend/ - this file has no dependencies of its own.",
  "scripts": {
    "build": "npm run build --prefix frontend",
    "check": "npm run check --prefix frontend",
    "dev": "npm run dev --prefix frontend",
    "dev:webpack": "npm run dev:webpack --prefix frontend",
    "format:check": "npm run format:check --prefix frontend",
    "format:write": "npm run format:write --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "lint:fix": "npm run lint:fix --prefix frontend",
    "preview": "npm run preview --prefix frontend",
    "start": "npm run start --prefix frontend",
    "typecheck": "npm run typecheck --prefix frontend"
  }
}
